# Cloudflare response headers. Fonts never change, so browsers can keep them for a year;
# images for a day. Pages, CSS and JS are re-checked on every visit so updates show at once.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=86400

# Baseline protections for every page
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
